/*
 * Waveshare ESP32-H2-DEV-KIT-N4: an ESP32-H2-MINI-1-N4 module with an onboard
 * WS2812 RGB LED on GPIO8 and a BOOT key on GPIO9.
 *
 * Copied from Zephyr's esp32h2_devkitm.dts (v4.4.0), which describes the same
 * module and pins. What was in SPLed's esp32h2_devkitm.overlay is now here:
 * the WS2812 driven over I2S with DMA (there is no RMT-based WS2812 driver in
 * the tree), and SPLed's three buttons wired to free header pins, since the
 * board has one usable key and SPLed needs three.
 */

/dts-v1/;

#include <espressif/esp32h2/esp32h2_mini_h4.dtsi>
#include "esp32h2_dev_kit_n4-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/led/led.h>
#include <espressif/partitions_0x0_default.dtsi>

/ {
	model = "Waveshare ESP32-H2-DEV-KIT-N4";
	compatible = "waveshare,esp32h2-dev-kit-n4";

	chosen {
		zephyr,sram = &sramhp;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,ieee802154 = &ieee802154;
	};

	aliases {
		sw0 = &power_button;
		sw1 = &up_button;
		sw2 = &down_button;
		led-strip = &led_strip;
		watchdog0 = &wdt0;
	};

	gpio_keys {
		compatible = "gpio-keys";

		boot_button: button_boot {
			label = "BOOT";
			gpios = <&gpio0 9 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_0>;
		};

		/* SPLed demo wiring: buttons between these header pins and GND. */
		power_button: button_power {
			label = "Power button";
			gpios = <&gpio0 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};

		up_button: button_up {
			label = "Up button";
			gpios = <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};

		down_button: button_down {
			label = "Down button";
			gpios = <&gpio0 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

&gpio0 {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&trng0 {
	status = "okay";
};

&coretemp {
	status = "okay";
};

&spi2 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <&spim2_default>;
	pinctrl-names = "default";
};

&i2c0 {
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
};

&i2c1 {
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c1_default>;
	pinctrl-names = "default";
};

&i2s {
	status = "okay";
	pinctrl-0 = <&i2s_default>;
	pinctrl-names = "default";

	dmas = <&dma 3>;
	dma-names = "tx";

	led_strip: ws2812@0 {
		compatible = "worldsemi,ws2812-i2s";

		reg = <0>;
		chain-length = <1>;
		color-mapping = <LED_COLOR_ID_GREEN
				 LED_COLOR_ID_RED
				 LED_COLOR_ID_BLUE>;
		reset-delay = <500>;
	};
};

&dma {
	status = "okay";
};

&twai {
	pinctrl-0 = <&twai_default>;
	pinctrl-names = "default";
};

&ieee802154 {
	status = "okay";
};

&esp32_bt_hci {
	status = "okay";
};
